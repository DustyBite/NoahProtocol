[node name="Text" type="Label" parent="Panel/emailTerminal/email2" unique_id=1599476746]
layout_mode = 0
offset_left = 5.0
offset_top = 5.0
offset_right = 295.0
offset_bottom = 230.0
theme_override_font_sizes/font_size = 13
text = "Good work.
     Use the aquired points to purchase upgades.
     Process, Upload, and Wipe upgrades are cards that are inserted into the top of the processing station that speed up the processing.
     Consumables unlock better food that provide more nurishment.
     Arcade buys a second machine."
autowrap_mode = 3

