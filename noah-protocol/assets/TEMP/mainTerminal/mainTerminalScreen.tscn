[node name="Text" type="Label" parent="Panel/emailTerminal/email1" unique_id=2015984570]
layout_mode = 0
offset_left = 5.0
offset_top = 5.0
offset_right = 295.0
offset_bottom = 230.0
theme_override_font_sizes/font_size = 13
text = "Welcome to your new position
Your job is to process Data cards.
     Start by pressing the button on the wall to your left to get a pallet.
     Remove a crate from the pallet, open it, and remove a data card.
     Insert the card into the processing station, and press the button to start processing.
     Return here for second email once 10 cards have been processed."
autowrap_mode = 3

[node name="email2" type="Panel" parent="Panel/emailTerminal" unique_id=1314851870]
